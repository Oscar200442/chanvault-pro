<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ChanVault Pro — 4chan Media Suite & Archiver</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #0b0c0e;
    }
    .font-mono-code {
      font-family: 'JetBrains Mono', monospace;
    }
    .glow-card {
      background: radial-gradient(100% 100% at 50% 0%, rgba(214, 75, 48, 0.08) 0%, rgba(18, 18, 22, 0.6) 100%);
    }
  </style>
</head>
<body class="text-zinc-100 min-h-screen flex flex-col antialiased selection:bg-[#d64b30] selection:text-white">

  <!-- Top Navigation -->
  <header class="max-w-6xl mx-auto w-full px-6 py-8 flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-[#d64b30] flex items-center justify-center font-black text-white text-base shadow-lg shadow-[#d64b30]/20">
        V
      </div>
      <div class="font-extrabold tracking-tight text-lg text-white flex items-center gap-1.5">
        ChanVault <span class="text-[10px] font-bold tracking-wider text-[#d64b30] uppercase border border-[#d64b30]/40 px-1.5 py-0.5 rounded">PRO</span>
      </div>
    </div>
    <a href="https://github.com/YOUR_GITHUB_USERNAME/YOUR_REPO" target="_blank" class="text-xs font-medium text-zinc-400 hover:text-white flex items-center gap-1.5 transition">
      GitHub <span>↗</span>
    </a>
  </header>

  <!-- Hero Section -->
  <main class="max-w-6xl mx-auto w-full px-6 flex-1 flex flex-col items-center">
    
    <!-- Version Tag -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-zinc-800 bg-zinc-900/60 text-[11px] font-mono-code text-zinc-400 mb-8">
      <span class="w-2 h-2 rounded-full bg-[#d64b30] animate-pulse"></span>
      VERSION 2.2.0 • EXTENSIONPAY INTEGRATED
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl font-extrabold text-center tracking-tight text-white max-w-3xl leading-[1.12]">
      Never lose media to <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#d64b30] to-orange-400">dead 404 threads</span> again.
    </h1>

    <p class="text-zinc-400 text-center text-sm sm:text-base max-w-xl mt-5 leading-relaxed">
      A lightweight power-suite for 4chan. Auto-grid view, 1-click bulk downloader, duplicate reaction filter, and background multi-thread watching.
    </p>

    <!-- Trust Badges -->
    <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 mt-6 text-xs text-zinc-400">
      <div class="flex items-center gap-1.5">
        <span class="text-emerald-400 font-bold">✓</span> No external tracking
      </div>
      <div class="flex items-center gap-1.5">
        <span class="text-emerald-400 font-bold">✓</span> Local IndexedDB vault
      </div>
      <div class="flex items-center gap-1.5">
        <span class="text-emerald-400 font-bold">✓</span> Original resolution masters
      </div>
    </div>

    <!-- Visual Before / After Showcase -->
    <div class="w-full mt-14 rounded-2xl border border-zinc-800/80 bg-zinc-950 p-3 sm:p-5 shadow-2xl relative">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        
        <!-- BEFORE -->
        <div class="relative rounded-xl overflow-hidden border border-zinc-900 bg-zinc-900/50 flex flex-col">
          <div class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded bg-black/80 backdrop-blur border border-zinc-800 text-[11px] font-mono-code text-zinc-400">
            Default 4chan UI
          </div>
          <div class="h-64 sm:h-80 flex flex-col justify-center items-center text-zinc-600 bg-zinc-900/40 p-6 text-center">
            <!-- Skift ud med et rigtigt screenshot af en rodet tråd -->
            <div class="text-3xl mb-2">📜</div>
            <div class="text-xs font-mono-code text-zinc-500">Endless text walls, tiny thumbnails & broken links after thread dies</div>
          </div>
          <div class="py-2.5 px-4 bg-zinc-900/90 border-t border-zinc-800 text-center text-xs font-medium text-red-400/90">
            Before: Cluttered & vulnerable to 404 purges
          </div>
        </div>

        <!-- AFTER -->
        <div class="relative rounded-xl overflow-hidden border border-[#d64b30]/30 bg-zinc-900/50 flex flex-col glow-card">
          <div class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded bg-[#d64b30]/90 backdrop-blur text-[11px] font-mono-code text-white font-semibold shadow">
            ChanVault Pro
          </div>
          <div class="h-64 sm:h-80 flex flex-col justify-center items-center text-zinc-300 p-6 text-center">
            <!-- Skift ud med et rigtigt screenshot af dit gallery/dashboard -->
            <div class="text-3xl mb-2">⚡</div>
            <div class="text-xs font-mono-code text-zinc-300">Clean Masonry Grid • Auto WebM Player • 1-Click Folder Export</div>
          </div>
          <div class="py-2.5 px-4 bg-[#d64b30]/10 border-t border-[#d64b30]/20 text-center text-xs font-medium text-orange-300">
            After: Instant offline vault & workstation
          </div>
        </div>

      </div>
    </div>

    <!-- Action / Pricing Cards -->
    <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-5 mt-12 mb-20 max-w-4xl">
      
      <!-- Primary Chrome Card -->
      <div class="rounded-xl border border-zinc-800 bg-[#121316] p-6 flex flex-col justify-between hover:border-zinc-700 transition">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono-code px-2 py-0.5 rounded bg-zinc-800 text-zinc-300">Google Chrome & Brave</span>
            <span class="text-xs font-mono-code text-emerald-400 font-medium">Manifest V3</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Chrome Extension</h3>
          <p class="text-xs text-zinc-400 leading-relaxed mb-6">
            Direct installation via Chrome Web Store or developer unpack. Includes auto-updates and local storage caching.
          </p>
        </div>

        <div>
          <a href="https://chrome.google.com/webstore/detail/YOUR_STORE_ID" target="_blank" class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-lg bg-[#d64b30] hover:bg-[#b83a21] text-white font-semibold text-sm transition shadow-lg shadow-[#d64b30]/20">
            Add to Chrome <span>↓</span>
          </a>
          <div class="flex items-center justify-between mt-3 text-[11px] text-zinc-500 font-mono-code">
            <span>One-time license: $2.99</span>
            <a href="https://extensionpay.com" target="_blank" class="hover:underline">via ExtensionPay</a>
          </div>
        </div>
      </div>

      <!-- Manual Zip / Dev Card -->
      <div class="rounded-xl border border-zinc-800 bg-[#121316] p-6 flex flex-col justify-between hover:border-zinc-700 transition">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono-code px-2 py-0.5 rounded bg-zinc-800 text-zinc-300">Direct Download</span>
            <span class="text-xs font-mono-code text-zinc-400 font-medium">ZIP Package</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Manual Installation</h3>
          <p class="text-xs text-zinc-400 leading-relaxed mb-6">
            Prefer loading unpacked via <code class="bg-zinc-800 px-1 rounded text-zinc-300">chrome://extensions</code>? Download the standalone build.
          </p>
        </div>

        <div>
          <a href="https://github.com/YOUR_GITHUB_USERNAME/YOUR_REPO/releases/latest" target="_blank" class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-lg bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-200 font-semibold text-sm transition">
            Download Latest .zip <span>📦</span>
          </a>
          <div class="flex items-center justify-between mt-3 text-[11px] text-zinc-500 font-mono-code">
            <span>Inspect source code</span>
            <a href="https://github.com/YOUR_GITHUB_USERNAME/YOUR_REPO" target="_blank" class="hover:underline">GitHub Repo →</a>
          </div>
        </div>
      </div>

    </div>

  </main>

  <!-- Footer -->
  <footer class="border-t border-zinc-900 py-6 text-center text-xs text-zinc-600 font-mono-code">
    Created with ChanVault Pro • Not affiliated with 4chan community
  </footer>

</body>
</html>
